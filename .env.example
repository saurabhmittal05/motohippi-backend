# ─── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (PgBouncer Transaction Pooler for app runtime - port 6543)
DATABASE_URL=postgresql://user:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection string (Session Pooler for Drizzle Kit migrations / schema push - port 5432)
DIRECT_URL=postgresql://user:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Port the server listens on (Railway injects this automatically)
PORT=3000

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Secret salt used in password hashing — set to any long random string
# (Changing this invalidates all existing passwords)
AUTH_SALT=motohippi_change_me_in_production

# ─── CORS ─────────────────────────────────────────────────────────────────────

# Your deployed frontend URL(s), comma-separated
# e.g. https://motohippi.vercel.app,https://motohippi.com
FRONTEND_URL=https://your-frontend.vercel.app

# ─── Optional ─────────────────────────────────────────────────────────────────

# Node environment
NODE_ENV=production

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Google OAuth (optional — skip if not using Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP Email settings for OTP verification (Nodemailer; falls back to console.log if unconfigured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@motohippi.com

# ─── Cashfree Payment Gateway ──────────────────────────────────────────────────
# CASHFREE_ENV: TEST (for Sandbox) or PRODUCTION (for Live)
CASHFREE_ENV=TEST
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# ─── Membership Plan Prices (INR) ──────────────────────────────────────────────
PLAN_PLUS_PRICE=299
PLAN_GOLD_PRICE=599
PLAN_PLATINUM_PRICE=999

