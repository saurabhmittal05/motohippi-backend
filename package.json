{
  "name": "motohippi-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "dev": "NODE_ENV=development node ./build.mjs && node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "node ./build.mjs && node ./dist/seed.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "2.3.3",
    "express": "5.2.1",
    "nodemailer": "^9.0.4",
    "pg": "8.22.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "pino-pretty": "13.1.3",
    "thread-stream": "3.1.0",
    "typescript": "5.8.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "25.9.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.11.14"
  }
}
